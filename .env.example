# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prospecting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prospecting

# LLM (OpenAI-compatible endpoint; local gpt-oss-120B by default)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=local
LLM_MODEL=gpt-oss-120b

# Semantic memory (self-hosted Mem0)
MEMORY_URL=http://localhost:8765
MEMORY_USER=prospecting

# Prospect data
APOLLO_API_KEY=
TAVILY_API_KEY=

# CRM (optional; CSV import works without any CRM)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_OWNER_ID=

# Email delivery
GMAIL_CLIENT_FILE=.claude/secrets/gmail-oauth-client.json
GMAIL_SENDERS_FILE=.claude/secrets/gmail-senders.json
GMAIL_AUTH_PORT=3847
SENDGRID_API_KEY=
EMAIL_PROVIDER=gmail

# LinkedIn via HeyReach (optional, off by default)
LINKEDIN_ENABLED=false
LINKEDIN_DAILY_LIMIT=20
HEYREACH_API_KEY=
HEYREACH_CAMPAIGN_ID=

# Notifications
SLACK_WEBHOOK_URL=

# Runtime
LOG_LEVEL=info
# DRY_RUN gates only outbound email sending; Apollo, Tavily, and LLM calls still run and spend
DRY_RUN=true
CSV_DATA_DIR=./data
LLM_EMBEDDING_MODEL=qwen3-embedding-0.6b
LLM_EMBEDDING_DIMS=1024
LLM_CHAT_UPSTREAM=http://localhost:8000
LLM_EMBED_UPSTREAM=http://localhost:8002

TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/prospecting

# Targeting and spend (defaults shown; all optional)
# TARGET_TITLES=VP Sales,Head of Sales,CRO,Revenue Operations
# MIN_SENIORITY=director
# DISQUALIFIED_DOMAINS=
# DISCOVERY_CONTACTS_PER_ACCOUNT=3
# DISCOVERY_CREDITS_PER_RUN=15
# APOLLO_DAILY_CREDIT_CAP=50
# CARPET_BOMB_WINDOW_DAYS=7
# MAX_CONTACTS_PER_WINDOW=2
# NEGATIVE_EVENT_DELAY_DAYS=21
# WARM_INTRO_CADENCE=gentle
# WARM_INTRO_MAX_EMAILS=2
# CADENCE=standard            (or gentle)
# CADENCE_MAX_STEPS=3
# CADENCE_MIN_DAYS_BETWEEN=3
# SEND_HOURS_START=8
# SEND_HOURS_END=16
# SEND_DAYS=tue,wed,thu
# Note: the daily cap is first-come-first-served; the 06:30-06:45 batch jobs
# draw before the hourly task executor by schedule order. Raise the cap if the
# executor backlog matters.
